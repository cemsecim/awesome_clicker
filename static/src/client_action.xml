<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="awesome_clicker.ClientAction">
    <div class="p-4">
        <h3>Clicks: <ClickValue value="clicker.clicks"/></h3>
        <button class="btn btn-primary" t-on-click="() => clicker.increment(10)">+10</button>

            <!-- level 1 -> ClickBots -->
        <div t-if="clicker.level >= 1" class="mt-3">
            <span>ClickBots: <ClickValue value="clicker.clickBots"/> (+10 / 10s)</span>
            <button t-on-click="() => clicker.buyClickBot()" t-att-disabled="clicker.clicks lt 1000">Buy (1000)</button>
        </div>

            <!-- SENİN SORDUĞUN YER İŞTE BURASI -->
        <div t-if="clicker.level >= 2" class="mt-3">
            BigBots: <ClickValue value="clicker.bigBots"/> (+100 clicks / 10s)
            <button t-on-click="() => clicker.buyBigBot()" t-att-disabled="clicker.clicks lt 5000">Buy BigBot (5000)</button>
        </div>
        <div>
            <div t-if="clicker.level >= 3" class="mt-3">
                Power: <t t-esc="clicker.power"/>x
                <button t-on-click="() => clicker.buyPower()" t-att-disabled="clicker.clicks lt 50000">
                    Buy Power (50k)
                </button>
            </div>
        </div>
        <!-- 16. Trees buraya -->
            <div t-if="clicker.level >= 4" class="mt-4 border-top pt-3">
                <h4>🌳 Trees</h4>
                <div>Total Trees: <t t-esc="clicker.getTotalTrees()" /> | Fruits: <t
                        t-esc="clicker.fruits.pear + clicker.fruits.cherry" /></div>

                <div class="mt-2"> Pear Trees: <t t-esc="clicker.trees.pear" /> - Fruits: <t
                        t-esc="clicker.fruits.pear" />
                <button class="btn btn-sm btn-success ms-2"
                        t-on-click="() => clicker.buyTree('pear')"
                        t-att-disabled="clicker.clicks lt 1000000">Buy Pear Tree (1M)</button>
                </div>
                <div class="mt-2"> Cherry Trees: <t t-esc="clicker.trees.cherry" /> - Fruits: <t
                        t-esc="clicker.fruits.cherry" />
                <button class="btn btn-sm btn-danger ms-2"
                        t-on-click="() => clicker.buyTree('cherry')"
                        t-att-disabled="clicker.clicks lt 1000000">Buy Cherry Tree (1M)</button>
                </div>
            </div>

    </div>
    <Notebook>
        <t t-set-slot="tab1" title="'Clicks'">
            <!-- tüm bot/power butonları buraya -->
        </t>
        <t t-set-slot="tab2" title="'Trees'">
            <!-- ağaçlar buraya -->
        </t>
    </Notebook>
</t>

</templates>
